# cp .env.example .env  – dann Werte setzen
# Pflicht: langes Zufallsgeheimnis, z.B.:  openssl rand -hex 32
JWT_SECRET=
# Pflicht: Datenbank-Passwort (nach dem ersten Start nicht mehr ändern – sonst passt es nicht mehr zur bestehenden DB)
POSTGRES_PASSWORD=
# POSTGRES_USER=scheisse
# POSTGRES_DB=scheisse

# Port der App im LAN: http://<pi>:8080
WEB_PORT=8080

# Images (Docker Hub, privat -> vorher "docker login")
IMAGE_REPO=olafimus/olivers-master-repo
TAG=1.0.0

# Leer = automatisch (Secure-Cookie nur bei HTTPS). Nur bei Problemen true/false erzwingen.
COOKIE_SECURE=

# pgAdmin (nur mit: docker compose --profile tools up -d)
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=
PGADMIN_PORT=5050
