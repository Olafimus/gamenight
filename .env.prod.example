# cp .env.prod.example .env.prod  und Werte setzen
# Pflicht: langes Zufallsgeheimnis (z.B. openssl rand -hex 32)
JWT_SECRET=
POSTGRES_PASSWORD=change-me
# POSTGRES_USER=scheisse
# POSTGRES_DB=scheisse
WEB_PORT=8080
# Ein Docker-Hub-Repo, Images per Tag-Praefix: <repo>:scheisse-server-<TAG>, <repo>:scheisse-web-<TAG>
# LAN-Registry z.B. IMAGE_REPO=192.168.1.10:5000/scheisse
IMAGE_REPO=olafimus/olivers-master-repo
TAG=latest
